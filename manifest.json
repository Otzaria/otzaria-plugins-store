{
  "schemaVersion": 1,
  "id": "otzaria.plugins_directory",
  "name": "חנות תוספים",
  "version": "2.8.1",
  "description": "מציג את חנות התוספים הרשמי של אוצריא (otzaria.org/plugins) ישירות בתוך האפליקציה.",
  "author": "אוצריא",
  "homepage": "https://otzaria.org/plugins",
  "entrypoint": "index.html",
  "stability": "stable",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "network.access",
    "app.run_on_startup",
    "app.startup_contributions",
    "events.subscribe:settings.changed"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "https://otzaria.org"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "חנות תוספים",
      "order": 950,
      "defaultPinned": true,
      "iconName": "store_microsoft_24_regular"
    },
    "background": {
      "entrypoint": "background.html"
    },
    "startup": {
      "activationEvents": ["app.startup"]
    },
    "publishedDataTypes": [],
    "databaseSources": []
  }
}