{
  "schemaVersion": 1,
  "id": "otzaria.plugins_directory",
  "name": "חנות תוספים",
  "version": "2.15.0",
  "description": "מציג את חנות התוספים הרשמי של אוצריא (otzaria.org/plugins) ישירות בתוך האפליקציה.",
  "author": "אוצריא",
  "homepage": "https://otzaria.org/plugins",
  "entrypoint": "index.html",
  "stability": "stable",
  "minAppVersion": "0.9.98.1",
  "sdkVersion": "1.x",
  "permissions": [
    "network.access",
    "plugin.open_other",
    "plugin.storage.read",
    "plugin.storage.write",
    "app.run_on_startup",
    "app.startup_contributions",
    "events.subscribe:settings.changed",
    "fs.user_files.read"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "https://otzaria.org"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "חנות תוספים",
      "order": 950,
      "defaultPinned": true,
      "iconName": "store_microsoft_24_regular"
    },
    "background": {
      "entrypoint": "background.html"
    },
    "startup": {
      "activationEvents": [
        {
          "topic": "app.startup",
          "when": { "storage": { "key": "otzaria_store_notify_startup", "notEquals": false } }
        }
      ]
    },
    "publishedDataTypes": [],
    "databaseSources": []
  }
}
